# systemd *user* service that starts the BikeHUD (main.py) at boot on Raspberry Pi OS Lite (no desktop).
# Needs `loginctl enable-linger $USER` so the user's services start at boot without anyone logging in.
# Install: see "Run on boot (systemd)" in pi_integration/README.md
# Assumes the repo is at ~/473_bikeHUD; edit ExecStart if it lives somewhere else.

[Unit]
Description=BikeHUD (main.py)
# keep retrying forever instead of giving up after a few quick crashes
StartLimitIntervalSec=0

[Service]
ExecStart=%h/473_bikeHUD/pi_integration/run_hud.sh
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
